---
---

<section class="hero" id="top">
  <div class="container">
    <div class="hero__frame" data-reveal data-reveal-group="hero" data-reveal-delay="80">
      <img
        class="hero__image"
        src="/images/home/hero.jpg"
        alt="Filipe Sales sitting on a chair in a studio, in front of a wall covered in hand-drawn doodles"
        loading="eager"
        decoding="async"
        width="2400"
        height="1665"
      />
    </div>

    <div class="hero__action" data-reveal data-reveal-group="hero" data-reveal-delay="140">
      <a class="hero__cta" href="/#work">
        See the work
        <span class="hero__cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 1.5rem + 2vw, 3rem) clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }

  .hero__frame {
    position: relative;
    /* Ratio chosen so the crop runs from just above "Creative Director" to just below the rug */
    aspect-ratio: 1.87;
    border-radius: clamp(20px, 3vw, 32px);
    overflow: hidden;
    background: var(--color-surface);
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 52%;
  }

  .hero__action {
    display: flex;
    justify-content: center;
    margin-top: clamp(28px, 4vw, 44px);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 22px;
    border-radius: var(--radius-full);
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-ink);
    font-weight: 600;
    font-size: 0.9375rem;
    transition:
      gap var(--duration-fast) var(--ease-out-quart),
      color var(--duration-fast) var(--ease-out-quart),
      border-color var(--duration-fast) var(--ease-out-quart);
  }

  .hero__cta-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    font-size: 0.75rem;
    transition: border-color var(--duration-fast) var(--ease-out-quart);
  }

  .hero__cta:hover,
  .hero__cta:focus-visible {
    gap: 14px;
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .hero__cta:hover .hero__cta-arrow,
  .hero__cta:focus-visible .hero__cta-arrow {
    border-color: var(--color-primary);
  }

  @media (max-width: 36rem) {
    .hero__frame {
      aspect-ratio: auto;
      height: clamp(420px, 78vh, 640px);
    }

    /* Extra height overflows the frame's bottom edge, cropping the floor below the rug */
    .hero__image {
      height: 110%;
      object-position: center bottom;
    }
  }
</style>
