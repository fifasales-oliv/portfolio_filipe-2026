---
import type { WorkCard } from "../data/workCards";

interface Props {
  card: WorkCard;
}

const { card } = Astro.props;
---

<a class="card" href={card.href} data-reveal data-reveal-group="work">
  <span class="card__media" data-card style={`aspect-ratio:${card.aspect}`}>
    <img
      src={card.image}
      alt={card.imageAlt}
      loading="lazy"
      decoding="async"
      width={card.width}
      height={card.height}
    />
    {card.reel && (
      <span class="card__reel" data-reel aria-hidden="true">
        {card.reel.map((frame) => (
          <span class="card__frame" style={`--c:${frame.color}`} data-src={frame.src}><i></i></span>
        ))}
      </span>
    )}
  </span>
  <span class="card__body">
    <span class="card__category">{card.category}</span>
    <span class="card__title">{card.title}</span>
    <span class="card__link">
      View project
      <span class="card__link-arrow">→</span>
    </span>
  </span>
</a>

<script>
  // Fast-cut reel: frames load only once the card nears the viewport, then the
  // still image is covered and frames hard-cut while the card stays in view.
  const FRAME_MS = 250;

  document.querySelectorAll<HTMLElement>("[data-reel]").forEach((reel) => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const frames = [...reel.querySelectorAll<HTMLElement>(".card__frame")];
    let index = 0;
    let timer: number | undefined;
    let loaded = false;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          if (!loaded) {
            frames.forEach((frame) => {
              frame.querySelector("i")!.style.backgroundImage = `url(${frame.dataset.src})`;
            });
            loaded = true;
          }
          reel.classList.add("is-playing");
          window.clearInterval(timer);
          timer =window.setInterval(() => {
            frames[index].classList.remove("is-active");
            index = (index + 1) % frames.length;
            frames[index].classList.add("is-active");
          }, FRAME_MS);
          frames[index].classList.add("is-active");
        } else {
          window.clearInterval(timer);
        }
      },
      { rootMargin: "200px 0px" },
    );
    observer.observe(reel);
  });
</script>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 22px;
    filter: none;
    transform: none;
    transition:
      filter 0.5s cubic-bezier(0.19, 1, 0.22, 1),
      transform 0.5s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .card__media {
    display: block;
    overflow: hidden;
    border-radius: clamp(14px, 1.6vw, 20px);
    background: var(--color-surface);
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out-quart);
  }

  /* Card hover lives in global.css + src/scripts/card-hover.ts (data-card) */

  .card__media {
    position: relative;
  }

  .card__reel {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: transform var(--duration-slow) var(--ease-out-quart);
  }

  .card__reel.is-playing {
    opacity: 1;
  }

  /* Hard cuts: frames swap visibility with no transition */
  .card__frame {
    position: absolute;
    inset: 0;
    background: var(--c);
    visibility: hidden;
  }

  .card__frame.is-active {
    visibility: visible;
  }

  /* Colour version of the mark = bottom-left 600×400 of each 1200×1200 logofolio card */
  .card__frame i {
    position: absolute;
    left: -25%;
    width: 150%;
    top: 50%;
    aspect-ratio: 3 / 2;
    transform: translateY(-50%);
    background-size: 200% auto;
    background-position: 0 100%;
    background-repeat: no-repeat;
    clip-path: inset(1.5% 0 0 0);
  }

  .card__category {
    display: block;
    font-size: var(--text-label);
    color: var(--color-muted);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .card__title {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.1rem, 3.6vw, 3.4rem);
    line-height: 0.96;
    letter-spacing: var(--tracking-display);
    margin-bottom: 16px;
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-label);
    font-weight: 600;
    color: var(--color-primary);
    padding-bottom: 2px;
    transition: gap var(--duration-fast) var(--ease-out-quart);
  }

  .card:hover .card__link,
  .card:focus-visible .card__link {
    gap: 12px;
  }
</style>
