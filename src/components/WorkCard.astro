---
import type { WorkCard } from "../data/workCards";

interface Props {
  card: WorkCard;
}

const { card } = Astro.props;
---

<a class="card" href={card.href} data-reveal data-reveal-group="work">
  <span class="card__media" style={`aspect-ratio:${card.aspect}`}>
    <img
      src={card.image}
      alt={card.imageAlt}
      loading="lazy"
      decoding="async"
      width={card.width}
      height={card.height}
    />
  </span>
  <span class="card__body">
    <span class="card__category">{card.category}</span>
    <span class="card__title">{card.title}</span>
    <span class="card__link">
      View project
      <span class="card__link-arrow">→</span>
    </span>
  </span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 22px;
    filter: none;
    transform: none;
    transition:
      filter 0.5s cubic-bezier(0.19, 1, 0.22, 1),
      transform 0.5s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .card__media {
    display: block;
    overflow: hidden;
    border-radius: clamp(14px, 1.6vw, 20px);
    background: var(--color-surface);
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out-quart);
  }

  .card:hover .card__media img,
  .card:focus-visible .card__media img {
    transform: scale(1.04);
  }

  .card__category {
    display: block;
    font-size: var(--text-label);
    color: var(--color-muted);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .card__title {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.1rem, 3.6vw, 3.4rem);
    line-height: 0.96;
    letter-spacing: var(--tracking-display);
    margin-bottom: 16px;
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-label);
    font-weight: 600;
    color: var(--color-primary);
    padding-bottom: 2px;
    transition: gap var(--duration-fast) var(--ease-out-quart);
  }

  .card:hover .card__link,
  .card:focus-visible .card__link {
    gap: 12px;
  }
</style>
