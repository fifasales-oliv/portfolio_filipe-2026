---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import FooterBento from "../components/FooterBento.astro";
import { experience } from "../data/experience";
import { education } from "../data/education";

// Each highlight becomes a card: the first words carry the weight, the rest finishes the sentence.
const highlights = [
  { lead: "19+ years", text: "in brand design, strategy, and creative direction" },
  {
    lead: "100+ brands",
    text: "created across Brazil, USA, Australia, Portugal, Mexico, and Colombia",
    accent: true,
  },
  { lead: "Co-founded", text: "and scaled a creative agency" },
  { lead: "Led rebranding", text: "and M&A brand integration at Cortex" },
  {
    lead: "Speaker",
    text: "and workshop facilitator on branding and creativity at universities, companies, and events — including HackTown 2025",
  },
];

const additionalTraining = [
  "Strategy Camp",
  "Naming",
  "Arquitetura de marcas",
  "Gestão avançada de marcas",
  "Design System",
  "Identidade Visual",
  "Direção de arte",
  "Liderança Criativa",
  "Técnicas de criatividade",
];

const educationLogos = [
  { src: "/images/about/logos/brandster.png", alt: "Brandster logo", width: 200, height: 200 },
  { src: "/images/about/logos/the-ugly-lab.jpg", alt: "The Ugly Lab logo", width: 400, height: 400 },
  { src: "/images/about/logos/miami-ad-school.svg", alt: "Miami Ad School logo", width: 1022, height: 514 },
];
---

<Layout
  title="About — Filipe Sales"
  description="Filipe Sales is a brand strategist and visual designer with 19+ years of experience in creative direction and brand strategy, based in Brazil."
>
  <Nav base="/" />
  <main id="main" class="about">
    <!-- Intro: who, what, now — beside the photo -->
    <section class="container intro" id="top">
      <div class="intro__text">
        <h1 class="intro__name" data-reveal data-reveal-group="intro">Filipe Sales</h1>
        <p class="intro__role" data-reveal data-reveal-group="intro" data-reveal-delay="60">
          Brand Strategist &amp; Visual Designer
        </p>
        <p class="intro__status" data-reveal data-reveal-group="intro" data-reveal-delay="120">
          <span>Currently at</span>
          <span class="chip">
            <img src="/images/home/cortex-mark.png" alt="" width="20" height="20" />
            Cortex
          </span>
          <span class="intro__based">Based in Brazil</span>
        </p>

        <div class="intro__bio" data-reveal data-reveal-group="intro" data-reveal-delay="180">
          <p class="intro__lede">I design brands that earn their place in the boardroom.</p>
          <p class="prose">
            I'm a brand strategist and visual designer with 19+ years working at the
            intersection of creative direction, brand strategy, and business impact. My
            career started in agencies and evolved through co-founding one — building it
            from zero to an awarded advertising agency and leading creative work for
            national and international clients across six countries.
          </p>
          <p class="prose">
            Today I lead the branding team at Cortex, Brazil's leading AI platform for GTM
            Intelligence. My work spans strategy and execution — from running the internal
            team and managing external creatives, to developing brand strategies, leading
            visual identity projects from scratch, building AI-powered brand tools, and
            designing the processes that keep everything consistent.
          </p>
          <p class="prose">
            I believe good brand design is a business argument made visually. The best
            work I've done has always started with a strategic problem and ended with
            something people remember.
          </p>
        </div>

        <div class="intro__actions" data-reveal data-reveal-group="intro" data-reveal-delay="240">
          <a class="intro__action" href="mailto:oi@filipesales.com.br">
            Let's talk <span aria-hidden="true">→</span>
          </a>
          <a class="intro__action" href="/#work">
            See work <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <figure data-card class="tile intro__photo" data-reveal data-reveal-group="intro" data-reveal-delay="100">
        <img
          src="/images/about/filipe-about-flags.jpg"
          alt="Filipe Sales mid-kick on a salt flat, surrounded by flags from around the world"
          loading="eager"
          decoding="async"
          width="1206"
          height="1445"
        />
      </figure>
    </section>

    <!-- Career highlights: one card each -->
    <section class="container block" aria-labelledby="highlights-heading">
      <h2 class="block__heading" id="highlights-heading" data-reveal data-reveal-group="highlights">
        Career highlights
      </h2>
      <ul class="highlights">
        {highlights.map((item, i) => (
          <li
            data-card
            class:list={["tile", "highlight", { "highlight--accent": item.accent }]}
            data-reveal
            data-reveal-group="highlights-list"
            data-reveal-delay={i * 70}
          >
            <strong class="highlight__lead">{item.lead}</strong>
            <span class="highlight__text">{item.text}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Work experience: a line follows the page down the list as you scroll -->
    <section class="container block" aria-labelledby="experience-heading">
      <article data-card class="tile card" data-reveal data-reveal-group="experience">
        <h2 class="card__heading" id="experience-heading">Work experience</h2>
        <div class="timeline" data-timeline>
          <span class="timeline__rail" aria-hidden="true">
            <span class="timeline__fill" data-timeline-fill></span>
            <span class="timeline__dot" data-timeline-dot></span>
          </span>
          <ol class="timeline__list">
            {experience.map((job, i) => (
              <li class:list={["timeline__item", { "is-active": i === 0 }]} data-timeline-item>
                <span class="timeline__years">{job.years}</span>
                <span class="timeline__job">
                  <span class="timeline__role">{job.role}</span>
                  <span class="timeline__company">{job.company}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
      </article>
    </section>

    <!-- Education + additional training, side by side -->
    <section class="container block block--pair" aria-label="Education and training">
      <article data-card class="tile card" data-reveal data-reveal-group="learning">
        <h2 class="card__heading">Education</h2>
        <ul class="degrees">
          {education.map((item) => (
            <li class="degrees__item">
              <span class="degrees__name">{item.degree}</span>
              <span class="degrees__meta">{item.institution} · {item.years}</span>
            </li>
          ))}
        </ul>
      </article>

      <article data-card class="tile card" data-reveal data-reveal-group="learning" data-reveal-delay="90">
        <h2 class="card__heading">Additional training</h2>
        <ul class="training__tags">
          {additionalTraining.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <ul class="training__schools" aria-label="Schools">
          {educationLogos.map((logo) => (
            <li class="training__school">
              <img
                src={logo.src}
                alt={logo.alt}
                loading="lazy"
                decoding="async"
                width={logo.width}
                height={logo.height}
              />
            </li>
          ))}
        </ul>
      </article>
    </section>
  </main>

  <FooterBento />
</Layout>

<script>
  // Work experience: the green line follows the page — it runs down to wherever the middle of
  // the screen sits in the list and lights the role there. Before the list, it rests on the
  // current role; past the end, it fills completely.
  const timeline = document.querySelector<HTMLElement>("[data-timeline]");

  if (timeline) {
    const fill = timeline.querySelector<HTMLElement>("[data-timeline-fill]")!;
    const dot = timeline.querySelector<HTMLElement>("[data-timeline-dot]")!;
    const items = [...timeline.querySelectorAll<HTMLElement>("[data-timeline-item]")];
    let frame = 0;

    const update = () => {
      frame = 0;
      const height = timeline.offsetHeight;
      const first = items[0];
      const restY = first.offsetTop + first.offsetHeight / 2;
      const probe = window.innerHeight * 0.55 - timeline.getBoundingClientRect().top;
      const y = Math.max(restY, Math.min(height, probe));

      // Transform-only: the fill scales from the top, the dot slides to the same point
      fill.style.transform = `scaleY(${y / height})`;
      dot.style.transform = `translate(-50%, calc(${y}px - 50%))`;

      const under =
        items.find((item) => y >= item.offsetTop && y < item.offsetTop + item.offsetHeight) ??
        items[items.length - 1];
      items.forEach((item) => item.classList.toggle("is-active", item === under));
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    update();
  }
</script>

<style>
  /* Same tile language as the home board */
  .about {
    --gap: clamp(0.75rem, 0.4rem + 1.2vw, 1.5rem);
    --tile-radius: clamp(20px, 2.2vw, 32px);
    --tile-bg: oklch(99% 0.004 92);
  }

  .tile {
    border-radius: var(--tile-radius);
    background: var(--tile-bg);
    box-shadow:
      0 0 0 1px oklch(0% 0 0 / 4%),
      0 1px 2px oklch(0% 0 0 / 4%);
  }

  /* ---------- Intro ---------- */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    padding-block: clamp(32px, 4vw, 56px) var(--space-3xl);
  }

  @media (min-width: 56rem) {
    .intro {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: start;
      gap: clamp(2rem, 1rem + 4vw, 5rem);
    }

    /* The photo stays in view while the bio scrolls past */
    .intro__photo {
      position: sticky;
      top: 6rem;
    }
  }

  .intro__name {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(2.75rem, 1.5rem + 3.6vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .intro__role {
    margin-top: var(--space-sm);
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink-soft);
  }

  .intro__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-md);
    font-size: 1rem;
    color: var(--color-ink-soft);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 1rem 0.3rem 0.5rem;
    border-radius: var(--radius-full);
    background: var(--tile-bg);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-ink);
    box-shadow:
      0 1px 3px oklch(0% 0 0 / 10%),
      0 1px 2px -1px oklch(0% 0 0 / 10%);
    transform: rotate(2deg);
  }

  .chip img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .intro__based {
    margin-left: var(--space-xs);
    color: var(--color-muted);
  }

  .intro__bio {
    margin-top: var(--space-xl);
    max-width: 62ch;
  }

  .intro__lede {
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-md);
    text-wrap: balance;
  }

  .intro__bio .prose {
    color: var(--color-muted-strong);
    margin-bottom: var(--space-sm);
    text-wrap: pretty;
  }

  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  .intro__action {
    display: inline-flex;
    gap: 0.5rem;
    font-weight: 600;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    transition:
      color var(--duration-fast) var(--ease-out-quart),
      gap var(--duration-fast) var(--ease-out-quart);
  }

  .intro__action:hover,
  .intro__action:focus-visible {
    color: var(--color-primary);
    gap: 0.75rem;
  }

  .intro__photo {
    margin: 0;
    overflow: hidden;
  }

  .intro__photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 70%;
  }

  /* ---------- Blocks ---------- */
  .block {
    padding-bottom: var(--gap);
  }

  .block__heading,
  .card__heading {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.5rem, 1.2rem + 0.9vw, 2rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .block__heading {
    margin-bottom: var(--space-md);
  }

  .card {
    padding: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
  }

  .card__heading {
    margin-bottom: var(--space-lg);
  }

  .block--pair {
    display: grid;
    gap: var(--gap);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 56rem) {
    .block--pair {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  /* ---------- Highlights ---------- */
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--gap);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 40rem) {
    .highlights {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Desktop: first row pairs a single card with the wide accent card, second row is three across */
  @media (min-width: 62rem) {
    .highlights {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .highlight--accent {
      grid-column: span 2;
    }
  }

  .highlight {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-xl);
    min-height: 13rem;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .highlight__lead {
    font-size: clamp(2rem, 1.4rem + 1.8vw, 3rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-ink);
  }

  .highlight__text {
    max-width: 34ch;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-muted-strong);
  }

  /* One card carries the brand colour, the way the home board leans on its purple tile */
  .highlight--accent {
    background: var(--color-primary);
    box-shadow: none;
  }

  .highlight--accent .highlight__lead {
    color: var(--color-on-primary);
    font-size: clamp(2.5rem, 1.6rem + 2.8vw, 4.25rem);
  }

  .highlight--accent .highlight__text {
    color: oklch(98% 0 0 / 88%);
    max-width: 40ch;
  }

  /* ---------- Work experience timeline ---------- */
  .timeline {
    position: relative;
    padding-left: var(--space-lg);
  }

  .timeline__rail {
    position: absolute;
    left: 0.35rem;
    top: 0;
    bottom: 0;
    width: 2px;
    border-radius: 2px;
    background: oklch(88% 0.008 86);
  }

  .timeline__fill {
    position: absolute;
    inset: 0;
    border-radius: 2px;
    background: var(--color-primary);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 120ms linear;
  }

  /* The dot rides the end of the line */
  .timeline__dot {
    position: absolute;
    left: 50%;
    top: 0;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 0 4px var(--tile-bg);
    transform: translate(-50%, -50%);
    transition: transform 120ms linear;
  }

  .timeline__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: var(--space-md);
    padding-block: var(--space-sm);
    opacity: 0.45;
    transition: opacity var(--duration-fast) var(--ease-out-quart);
  }

  .timeline__item.is-active {
    opacity: 1;
  }

  .timeline__years {
    padding-top: 0.2rem;
    font-size: var(--text-label);
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  .timeline__job {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .timeline__role {
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
    transition: color var(--duration-fast) var(--ease-out-quart);
  }

  .timeline__item.is-active .timeline__role {
    color: var(--color-primary);
  }

  .timeline__company {
    font-size: 0.9375rem;
    color: var(--color-muted-strong);
  }

  /* ---------- Education + training ---------- */
  .degrees {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .degrees__item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .degrees__name {
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .degrees__meta {
    font-size: 0.9375rem;
    color: var(--color-muted-strong);
  }

  .training__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    margin: 0 0 var(--space-lg);
    padding: 0;
  }

  .training__tags li {
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background: var(--color-bg);
    font-size: var(--text-label);
    color: var(--color-ink-soft);
  }

  .training__schools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .training__school {
    display: flex;
    align-items: center;
    height: 44px;
  }

  .training__school img {
    height: 100%;
    width: auto;
    object-fit: contain;
  }

  @media (max-width: 36rem) {
    .highlight {
      min-height: 0;
      gap: var(--space-md);
    }

    .timeline__item {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }

    .timeline__years {
      order: 2;
      padding-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline__fill,
    .timeline__dot,
    .timeline__item,
    .timeline__role {
      transition: none;
    }
  }
</style>
